{
  "name": "pi-clipboard-paste",
  "version": "1.0.0",
  "description": "Paste copied file paths (space-separated), clipboard images, and text in pi on Windows via Ctrl+V or Alt+V",
  "keywords": [
    "pi-extension",
    "pi-package",
    "windows",
    "clipboard"
  ],
  "author": "DarkNeptune",
  "license": "MIT",
  "homepage": "https://github.com/dado1234ad/pi-clipboard-paste#readme",
  "bugs": {
    "url": "https://github.com/dado1234ad/pi-clipboard-paste/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dado1234ad/pi-clipboard-paste.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": ["./extensions/clipboard-paste.js"],
    "changelogPath": "./CHANGELOG.md"
  }
}